# 复制此文件为 .env，填入真实的 API Key
# cp .env.example .env

# ====== Provider 选择（可选，不填则使用默认值） ======
# DATA_PROVIDER=tushare            # 数据源：tushare（默认）
# LLM_PROVIDER=minimax             # AI模型：minimax（默认）| openai
# SEARCH_PROVIDER=auto             # 搜索：auto（默认，Tavily优先/AI降级）| tavily | ai_summary | none

# ====== 数据源配置 ======
# Tushare（默认数据源）- 申请地址：http://tsy.xiaodefa.cn
TUSHARE_API_TOKEN=your_tushare_token_here
TUSHARE_API_URL=https://tt.xiaodefa.cn
# 备用域名：https://fast.xiaodefa.cn
# 如果本地网络 https 报 SSL 错误，可按服务方说明临时改用 http://tt.xiaodefa.cn

# ====== AI 大模型配置 ======

# MiniMax（默认）
MINIMA_API_KEY=your_minima_api_key_here
# MINIMA_API_URL=https://api.minimaxi.com/anthropic
# MINIMA_MODEL=MiniMax-M2.7

# OpenAI 兼容（当 LLM_PROVIDER=openai 时使用）
# 支持：OpenAI、DeepSeek、通义千问、文心一言等所有 /v1/chat/completions 格式的服务
# OPENAI_API_KEY=your_key_here
# OPENAI_API_URL=https://api.openai.com        # OpenAI 官方
# OPENAI_API_URL=https://api.deepseek.com      # DeepSeek
# OPENAI_API_URL=https://dashscope.aliyuncs.com/compatible-mode  # 通义千问
# OPENAI_MODEL=gpt-4o                          # 或 deepseek-chat、qwen-max 等

# ====== 搜索/研究配置 ======
# Tavily（SEARCH_PROVIDER=auto/tavily 时优先使用）- 申请地址：https://tavily.com
# TAVILY_API_KEY=your_tavily_key_here
# 也兼容：TAVILY_API_TOKEN / TAVILY_TOKEN / TAVILY_KEY

# ====== 可选 Tushare 接口能力 ======
# 部分兼容网关不开放以下接口，默认关闭以减少非核心失败噪音。
# ENABLE_OPTIONAL_CONCEPTS=1
# ENABLE_OPTIONAL_MACRO_NEWS=1
